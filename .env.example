# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL  — use the "Transaction" pooler (port 6543) for serverless/Vercel
# DIRECT_URL    — use the "Session" pooler or direct connection (port 5432) for migrations
#
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ─── Supabase Auth ────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
