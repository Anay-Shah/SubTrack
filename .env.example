# ─── Database ────────────────────────────────────────────────────────────────
# Use absolute path for SQLite to avoid path resolution issues in Next.js/Turbopack
# Replace with your actual project path, or use a PostgreSQL connection string for production
DATABASE_URL="file:/absolute/path/to/your/project/prisma/dev.db"

# PostgreSQL example (for production):
# DATABASE_URL="postgresql://user:password@localhost:5432/subtrack"

# ─── Supabase Auth ────────────────────────────────────────────────────────────
# Create a project at https://supabase.com and copy these from:
# Project Settings → API → Project URL / anon public key
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
